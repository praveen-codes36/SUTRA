# SUTRA Environment Variables (Template)
# Copy this file to .env and populate with your local values.
# NEVER commit your actual .env file to Git.

# LLM Provider Configuration (gemini, openai, ollama, lmstudio)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM / Ollama Endpoint (if using local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding Configuration (local, bge-m3, openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# Application Settings
SUTRA_ENV=development
LOG_LEVEL=INFO
