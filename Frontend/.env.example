# SUTRA Frontend Environment Configuration (Template)
# Copy this file to .env to customize local frontend behavior.
# NEVER commit your actual .env file.

# Data mode: 'demo' (bundled benchmark data) or 'live' (FastAPI backend)
VITE_DATA_MODE=demo

# Whether users can switch between demo and live modes in Settings
VITE_ALLOW_MODE_SWITCH=true

# SUTRA FastAPI backend base URL (used strictly in 'live' mode)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Router mode: 'hash' (recommended for iframe/preview hosting) or 'browser'
VITE_ROUTER_MODE=hash

# Organization display timezone
VITE_ORG_TIMEZONE=Asia/Kolkata

# Request timeouts (milliseconds)
VITE_REQUEST_TIMEOUT_MS=20000
VITE_ANSWER_TIMEOUT_MS=45000
VITE_UPLOAD_TIMEOUT_MS=120000

# Maximum file upload size in megabytes for browser pre-check
VITE_MAX_UPLOAD_MB=100

# CSRF header name sent on mutating requests
VITE_CSRF_HEADER=X-CSRF-Token
